# Copy to .env here. Keep server credentials out of NEXT_PUBLIC_ variables.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe
PHOTON_URL=https://photon.komoot.io/api/
USER_AGENT=LoneStarSupport-local/0.1
# Set these to fit the quotas shown in your Google AI Studio project.
GEMINI_REQUESTS_PER_MINUTE=5
GEMINI_REQUESTS_PER_DAY=100
GEOCODER_INTERVAL_SECONDS=15
MAX_QUEUE_SIZE=1000
MAX_POST_AGE_HOURS=24
# Add smaller Texas localities relevant to your monitoring, comma-separated.
EXTRA_TEXAS_TERMS=
# false admits disaster keywords without a regional keyword; consumes more quota.
REQUIRE_TEXAS_KEYWORD=true
