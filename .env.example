# Read-only publishable (or legacy anon) key, never a service-role key.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Community reports. Also configure the hash of this secret in Supabase;
# see documentation/Community_Reports.md. Never use a NEXT_PUBLIC_ name.
COMMUNITY_REPORT_SECRET=
# Production: one IP header overwritten by your trusted ingress, not a forwarded list.
# Example only: cf-connecting-ip behind a locked-down Cloudflare ingress.
REPORT_CLIENT_IP_HEADER=
# Canonical website origin when deployed behind a reverse proxy, e.g. https://example.org
APP_ORIGIN=
